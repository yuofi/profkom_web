# The production image from a dist built elsewhere: the build with node needs more memory
# than the server has (DEPLOY.md). Build dist with the VITE_* of production, copy it into
# frontend/dist on the server, then from frontend/:
#   docker build -f Dockerfile.prebuilt -t profkom_web-frontend .
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html
EXPOSE 443
CMD ["nginx", "-g", "daemon off;"]
