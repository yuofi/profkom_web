S3_ENDPOINT=https://s3.cloud.ru
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_TENANT_ID=
ADMIN_NAME=
ADMIN_PASSWORD=
S3_REGION_NAME=ru-central-1
DATABASE_PATH=/app/data/profcom.db
# Set APP_ENV=production on the server: it enables the startup checks below.
APP_ENV=
# Required for APP_ENV=production; generate and inject a unique random secret.
JWT_SECRET_KEY=
FRONTEND_URL=https://profkom.example.com
# VK ID application of the site; must equal the frontend's VITE_APP_ID. Required for
# APP_ENV=production (the backend refuses to start without it); VK login answers 503 otherwise.
VK_CLIENT_ID=
# Optional. SHA-256 (lowercase hex) of the HereBot service token; two comma-separated values
# while the token is rotated. Empty: /api/bot/v1 answers 404 (backend/docs/BOT_API.md).
# The token itself lives only in the bot's .env (SITE_BOT_TOKEN).
BOT_API_TOKEN_SHA256=
# Optional, stage 2 of the bot (VK link). The bot's dialog for the "Open the bot" button:
# https://vk.me/<short name> or https://vk.me/club<id>, without a query. Empty: only the command.
BOT_VK_URL=
# Optional. From this moment an active account without a working VK link is closed until it
# links; ISO 8601 with an offset, e.g. 2026-12-01T00:00:00+03:00. Empty: only a banner.
BOT_LINK_DEADLINE=
# Optional, stage 3 of the bot (notifications in VK). The site's address for people in the
# links of those messages, http(s)://host[/path] without a trailing slash. Empty: FRONTEND_URL.
# With APP_ENV=production and BOT_API_TOKEN_SHA256 set it must be https:// (the backend
# refuses to start otherwise).
PUBLIC_SITE_URL=
